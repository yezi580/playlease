# ===== LLM（必填，OpenAI 兼容接口，默认 DeepSeek）=====
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_API_KEY=
AI_LLM_MODEL=deepseek-chat

# ===== Embedding（选填）=====
# 配置后启用「向量 + 词法」混合检索；不配置则自动退化为纯词法检索（本地开发零依赖可跑）
# 需要一个 OpenAI 兼容的 /embeddings 接口（智谱 / 阿里 DashScope / 硅基流动等）
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# ===== 主站 Node 服务地址（工具调用查商品用）=====
# 本地开发：http://localhost:3000 ；docker compose 内：http://api:3000
NODE_BASE_URL=http://localhost:3000

# ===== 内部通信令牌 =====
# 与 Node 侧的 AI_SERVICE_TOKEN 保持一致；留空 = 不校验（仅限本地开发）
AI_SERVICE_TOKEN=

# ===== 调优参数（一般不用动）=====
AI_RAG_TOP_K=4
AI_LLM_TEMPERATURE=0.3
AI_LLM_MAX_TOKENS=1024
AI_MAX_TOOL_ROUNDS=3
AI_MAX_INPUT_CHARS=2000
AI_HISTORY_LIMIT=10
